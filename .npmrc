# Supply-chain hardening. Requires npm >= 11 (`npm --version`); on older npm
# these keys are ignored rather than rejected, so verify before relying on them.

# Days a version must have existed before npm will install it. NOTE the unit
# differs from pnpm, which takes MINUTES — the two repos express the same
# one-day quarantine as `1` here and `1440` in pnpm-workspace.yaml.
#
# Malicious releases are usually caught and unpublished within hours, so the
# window in which a compromised version is installable is short. This closes it.
min-release-age=1

# Enforces the `engines` field in package.json, which requires npm >= 11. That
# pairing is the point: without it, installing on npm 10 would ignore
# `min-release-age` above and drop the quarantine with no warning at all.
engine-strict=true
