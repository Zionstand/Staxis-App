# localhost only works in the iOS simulator / Android emulator, NOT on a
# physical device via Expo Go — there localhost is the phone itself.
# Use your dev machine's LAN IP so a real device can reach the backend.
# EXPO_PUBLIC_BACKEND_URL=http://localhost:8000
EXPO_PUBLIC_BACKEND_URL=http://192.168.0.103:8000
EXPO_PUBLIC_MOBILE_APP_SECRET=f02db6faaef0b7bbe50e0fbfc6f2be2073a2b6a76e7a80303a0b287abfd78f15
# Google OAuth web client ID (same one the web app uses). The backend exchanges
# the auth code with this client's secret, so the app must use the SAME id.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=527149081814-mi6tpcmvnvpjk9ti223k5lmvgsbr1a0t.apps.googleusercontent.com
# iOS OAuth client ID (native builds only) — create an "iOS" client in Google
# Cloud for bundle id com.tomiwaadelae.app, then paste its client ID here.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Paystack PUBLIC key (pk_...) — same account as the web app. Safe in-client.
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_6830b4f7c3bb7bddbd5fc4c8701d2cf2350e7609
